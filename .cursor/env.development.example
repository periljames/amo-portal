# =========================
# Local development environment template (consumed by .cursor/install.sh)
# The install script copies this to <repo>/.env.development and replaces the
# __REPO_ROOT__ placeholder with the absolute repository path.
# NOT for production. Values here are safe local-only defaults.
# =========================
APP_ENV=development
TZ=UTC

PORTAL_DOMAIN=localhost

# =========================
# Backend runtime
# =========================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080

SECRET_KEY=dev-secret-key-not-for-production-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_PEPPER=dev-refresh-pepper-not-for-production-0123456789abcdef

# CORS: allow the local Vite dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_REGEX=
CORS_ALLOW_CREDENTIALS=true
PORTAL_REFRESH_COOKIE_SECURE=false

MAX_REQUEST_BODY_BYTES=52428800
GZIP_MINIMUM_SIZE=1024
GZIP_COMPRESSLEVEL=6
PLATFORM_SETTINGS_CACHE_TTL_SEC=30

# Do not block dev API startup on alembic head parity.
SCHEMA_STRICT=false

# =========================
# Database connectivity (local PostgreSQL)
# =========================
DATABASE_WRITE_URL=postgresql+psycopg2://amodb_app:amodb_app_dev@127.0.0.1:5432/amodb
DATABASE_READ_URL=
DATABASE_MIGRATION_URL=postgresql+psycopg2://amodb_migrator:amodb_migrator_dev@127.0.0.1:5432/amodb

DB_EXTERNAL_POOLER=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE_SEC=1800
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
DB_READ_ONLY_TRANSACTIONS=false
DB_MAX_CONNECTIONS=100
DB_ADMIN_CONNECTION_RESERVE=10
DB_MIGRATION_CONNECTION_RESERVE=5

# =========================
# Runtime topology / bounded parallelism (small local footprint)
# =========================
PORTAL_API_PROCESS_COUNT=1
PORTAL_EMBEDDED_JOB_WORKER=false
PORTAL_EMBEDDED_SCHEDULED_WORKER=false
DOCUMENT_EVIDENCE_PACK_EMBEDDED_WORKER=false

PORTAL_WORKER_FAMILIES=workforce,saas,training-workbooks,training-reports,document-indexing
PORTAL_WORKER_CONCURRENCY=1
PORTAL_WORKER_PROCESS_COUNT=5
PORTAL_WORKER_DB_POOL_SIZE=2
PORTAL_WORKER_DB_MAX_OVERFLOW=1
PORTAL_WORKER_DB_POOL_TIMEOUT=3
TRAINING_REPORT_JOB_INTERVAL_SECONDS=1
DOCUMENT_INDEX_WORKER_POLL_SECONDS=1

PORTAL_SCHEDULED_PROCESS_COUNT=1
PORTAL_SCHEDULED_DB_POOL_SIZE=2
PORTAL_SCHEDULED_DB_MAX_OVERFLOW=1
PORTAL_SCHEDULED_DB_POOL_TIMEOUT=3

DOCUMENT_EVIDENCE_PACK_PROCESS_COUNT=1
DOCUMENT_EVIDENCE_PACK_DB_POOL_SIZE=1
DOCUMENT_EVIDENCE_PACK_DB_MAX_OVERFLOW=1
DOCUMENT_EVIDENCE_PACK_DB_POOL_TIMEOUT=3
DOCUMENT_EVIDENCE_PACK_WORKER_POLL_SECONDS=0.5

ROSTER_AUTOMATION_PROCESS_COUNT=1
ROSTER_AUTOMATION_DB_POOL_SIZE=1
ROSTER_AUTOMATION_DB_MAX_OVERFLOW=1
ROSTER_AUTOMATION_DB_POOL_TIMEOUT=3

# =========================
# Realtime broker (disabled locally; no MQTT broker in dev)
# =========================
REALTIME_ENABLED=false
MQTT_BROKER_WS_URL=
MQTT_BROKER_INTERNAL_URL=
MQTT_AUTH_MODE=jwt
REALTIME_CONNECT_TOKEN_TTL_SECONDS=300
REALTIME_PAYLOAD_MAX_BYTES=8192

# =========================
# Shared object storage (local filesystem in dev)
# =========================
AMO_STORAGE_BACKEND=local
AMO_REQUIRE_SHARED_STORAGE=false
AMO_STORAGE_LOCAL_ROOT=__REPO_ROOT__/backend/uploads/local
AMO_STORAGE_CACHE_DIR=__REPO_ROOT__/var/amo-object-cache
AMO_STORAGE_CACHE_MAX_BYTES=2147483648
AMO_STORAGE_CACHE_MAX_AGE_SEC=86400

AMO_ASSET_UPLOAD_DIR=__REPO_ROOT__/backend/uploads/amo_assets
TRAINING_UPLOAD_DIR=__REPO_ROOT__/backend/uploads/training
AIRCRAFT_DOC_UPLOAD_DIR=__REPO_ROOT__/backend/uploads/aircraft_documents
EHM_LOG_UPLOAD_DIR=__REPO_ROOT__/backend/uploads/ehm
PROCUREMENT_DOCUMENT_DIR=__REPO_ROOT__/backend/uploads/procurement-documents

AMO_ASSET_MAX_UPLOAD_BYTES=52428800
TRAINING_MAX_UPLOAD_BYTES=52428800
EHM_LOG_MAX_UPLOAD_BYTES=52428800

# =========================
# Platform Operations gateway / worker
# =========================
PLATFORM_OPS_GATEWAY_PROCESS_COUNT=1
PLATFORM_OPS_WORKER_PROCESS_COUNT=1
PLATFORM_OPS_DB_POOL_SIZE=3
PLATFORM_OPS_DB_MAX_OVERFLOW=2
PLATFORM_OPS_DB_POOL_TIMEOUT=3
PLATFORM_OPS_WORKER_DB_POOL_SIZE=2
PLATFORM_OPS_WORKER_DB_MAX_OVERFLOW=1
PLATFORM_OPS_WORKER_DB_POOL_TIMEOUT=3
PLATFORM_OPS_WORKER_SECONDS=2
PLATFORM_OPS_WORKER_BATCH_SIZE=10
PLATFORM_OPS_JOB_LEASE_SECONDS=120
PLATFORM_OPS_QUERY_CONCURRENCY=4
PLATFORM_OPS_RATE_LIMIT_PER_MINUTE=240

# =========================
# OpenTelemetry (disabled locally)
# =========================
OTEL_ENABLED=false

# =========================
# Frontend build/runtime
# Leave VITE_API_BASE_URL blank so the Vite dev proxy targets 127.0.0.1:8080.
# =========================
VITE_API_BASE_URL=
VITE_PORTAL_URL=http://localhost:5173
VITE_REALTIME_ENABLED=0
VITE_PLATFORM_OPS_BASE_URL=
VITE_MANUALS_PWA_ENABLED=0

# =========================
# Optional integrations (disabled locally)
# =========================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

DOCUMENT_AI_PROVIDER=disabled
DOCUMENT_AI_ALLOW_EXTERNAL=false
