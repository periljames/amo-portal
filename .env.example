# =========================
# Core environment
# =========================
APP_ENV=production
TZ=UTC

# Public URL used by EDGE virtual host and frontend API base
PORTAL_DOMAIN=portal.UNKNOWN__FILL_ME

# =========================
# Backend runtime
# =========================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080

# JWT/app secret (must come from secret store)
SECRET_KEY=PLACEHOLDER__SET_IN_SECRET_STORE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://portal.UNKNOWN__FILL_ME
CORS_ALLOWED_ORIGIN_REGEX=
CORS_ALLOW_CREDENTIALS=true

# Request/body tuning
MAX_REQUEST_BODY_BYTES=UNKNOWN__FILL_ME
GZIP_MINIMUM_SIZE=1024
GZIP_COMPRESSLEVEL=6
PLATFORM_SETTINGS_CACHE_TTL_SEC=30

# Schema safety
SCHEMA_STRICT=true

# =========================
# Database connectivity
# =========================
# Runtime app user URL
DATABASE_WRITE_URL=postgresql+psycopg2://amodb_app:PLACEHOLDER__SET_IN_SECRET_STORE@DB_HOST_UNKNOWN__FILL_ME:5432/amodb
DATABASE_READ_URL=

# Migration/admin URL (optional separate role)
DATABASE_MIGRATION_URL=postgresql+psycopg2://amodb_migrator:PLACEHOLDER__SET_IN_SECRET_STORE@DB_HOST_UNKNOWN__FILL_ME:5432/amodb

# Set true when PgBouncer or another external transaction pooler owns connection
# multiplexing. The application will use NullPool in this mode.
DB_EXTERNAL_POOLER=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SEC=1800
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# Use for read-only analytics/gateway processes, not the normal write API.
DB_READ_ONLY_TRANSACTIONS=false

# =========================
# Realtime broker
# =========================
REALTIME_ENABLED=true
MQTT_BROKER_WS_URL=wss://broker.UNKNOWN__FILL_ME/mqtt
MQTT_BROKER_INTERNAL_URL=tcp://broker.internal.UNKNOWN__FILL_ME:1883
MQTT_AUTH_MODE=jwt
REALTIME_CONNECT_TOKEN_TTL_SECONDS=300
REALTIME_PAYLOAD_MAX_BYTES=8192

# =========================
# Shared object storage
# =========================
# Production horizontal deployments should use an S3-compatible object store
# (AWS S3, MinIO, Cloudflare R2, Ceph RGW, etc.) and require it explicitly.
AMO_STORAGE_BACKEND=s3
AMO_REQUIRE_SHARED_STORAGE=true
AMO_STORAGE_S3_BUCKET=UNKNOWN__FILL_ME
AMO_STORAGE_S3_PREFIX=amo-portal
AMO_STORAGE_S3_REGION=
AMO_STORAGE_S3_ENDPOINT_URL=
AMO_STORAGE_S3_ADDRESSING_STYLE=auto
# AES256 for provider-managed encryption, aws:kms with KMS key ID where required.
AMO_STORAGE_S3_SSE=AES256
AMO_STORAGE_S3_KMS_KEY_ID=
AMO_STORAGE_CONNECT_TIMEOUT_SEC=3
AMO_STORAGE_READ_TIMEOUT_SEC=30
AMO_STORAGE_MAX_ATTEMPTS=3
# Materialized downloads are an ephemeral bounded cache and are not authoritative.
AMO_STORAGE_CACHE_DIR=/tmp/amo-object-cache
AMO_STORAGE_CACHE_MAX_BYTES=2147483648
AMO_STORAGE_CACHE_MAX_AGE_SEC=86400
# Local fallback is for development/single-node operation only.
AMO_STORAGE_LOCAL_ROOT=/srv/amo/uploads

# Legacy upload directory variables remain during controlled migration of every
# file-owning module. They are staging/compatibility paths, not the horizontal
# source of truth when AMO_STORAGE_BACKEND=s3.
AMO_ASSET_UPLOAD_DIR=/srv/amo/uploads/amo_assets
TRAINING_UPLOAD_DIR=/srv/amo/uploads/training
AIRCRAFT_DOC_UPLOAD_DIR=/srv/amo/uploads/aircraft_documents
EHM_LOG_UPLOAD_DIR=/srv/amo/uploads/ehm
PROCUREMENT_DOCUMENT_DIR=/srv/amo/uploads/procurement-documents

AMO_ASSET_MAX_UPLOAD_BYTES=UNKNOWN__FILL_ME
TRAINING_MAX_UPLOAD_BYTES=UNKNOWN__FILL_ME
EHM_LOG_MAX_UPLOAD_BYTES=UNKNOWN__FILL_ME

# =========================
# Platform Operations gateway / worker
# =========================
PLATFORM_OPS_DB_POOL_SIZE=3
PLATFORM_OPS_DB_MAX_OVERFLOW=2
PLATFORM_OPS_DB_POOL_TIMEOUT=3
PLATFORM_OPS_DB_STATEMENT_TIMEOUT_MS=15000
PLATFORM_OPS_DB_IDLE_TX_TIMEOUT_MS=30000
PLATFORM_OPS_WORKER_DB_POOL_SIZE=2
PLATFORM_OPS_WORKER_DB_MAX_OVERFLOW=1
PLATFORM_OPS_WORKER_DB_POOL_TIMEOUT=3
PLATFORM_OPS_WORKER_DB_STATEMENT_TIMEOUT_MS=30000
PLATFORM_OPS_WORKER_DB_IDLE_TX_TIMEOUT_MS=60000
PLATFORM_OPS_WORKER_SECONDS=2
PLATFORM_OPS_WORKER_BATCH_SIZE=10
PLATFORM_OPS_JOB_LEASE_SECONDS=120
PLATFORM_OPS_PROMETHEUS_URL=http://OBSERVABILITY_PRIVATE_HOST_UNKNOWN__FILL_ME:9090
PLATFORM_OPS_QUERY_CONCURRENCY=4
PLATFORM_OPS_RATE_LIMIT_PER_MINUTE=240

# =========================
# OpenTelemetry application export
# =========================
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://OTEL_PRIVATE_HOST_UNKNOWN__FILL_ME:4318
OTEL_EXPORT_TIMEOUT_SEC=2
OTEL_METRIC_EXPORT_INTERVAL_MS=10000
OTEL_QUEUE_METRIC_CACHE_SEC=10
OTEL_RUNTIME_METRIC_CACHE_SEC=10
OTEL_DB_LONG_QUERY_SECONDS=5

# =========================
# Frontend build/runtime
# =========================
VITE_API_BASE_URL=https://portal.UNKNOWN__FILL_ME
VITE_PORTAL_URL=https://portal.UNKNOWN__FILL_ME
# Realtime is explicit opt-in at build time. Keep this aligned with REALTIME_ENABLED
# and only enable it when MQTT_BROKER_WS_URL is reachable from portal browsers.
VITE_REALTIME_ENABLED=1
# Blank uses the same-origin /ops/ reverse proxy.
VITE_PLATFORM_OPS_BASE_URL=
VITE_MANUALS_PWA_ENABLED=0

# =========================
# Optional integrations (set only if used)
# =========================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=PLACEHOLDER__SET_IN_SECRET_STORE
SMTP_FROM=

WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_BEARER=PLACEHOLDER__SET_IN_SECRET_STORE

# Documentation assisted search works without an external provider. Leave disabled
# until an approved data-processing/security review authorises external synthesis.
DOCUMENT_AI_PROVIDER=disabled
DOCUMENT_AI_ALLOW_EXTERNAL=false
DOCUMENT_AI_MODEL=
OPENAI_API_KEY=PLACEHOLDER__SET_IN_SECRET_STORE

# =========================
# TLS / ACME metadata (optional admin status fields)
# =========================
ACME_DIRECTORY_URL=
ACME_CLIENT=
ACME_CERT_STATUS=
ACME_CERT_ISSUER=
ACME_CERT_EXPIRES_AT=
ACME_CERT_RENEWED_AT=

# =========================
# Backup policy placeholders
# =========================
BACKUP_RETENTION_DAYS=UNKNOWN__FILL_ME
BACKUP_TARGET_PATH=/mnt/nas/UNKNOWN__FILL_ME/backups

# =========================
# AeroDoc Hybrid-DMS independent replication policy
# =========================
AERODOC_VERIFY_RATE_LIMIT_WINDOW_SEC=60
AERODOC_VERIFY_RATE_LIMIT_MAX_ATTEMPTS=20
AERODOC_AWS_MIRROR_PATH=/srv/amo/aerodoc/aws_mirror
AERODOC_AZURE_MIRROR_PATH=/srv/amo/aerodoc/azure_mirror
AERODOC_ONPREM_MIRROR_PATH=/srv/amo/aerodoc/onprem_mirror
VITE_AERODOC_PWA_ENABLED=0
AERODOC_REPLICATION_RETRIES=2
AERODOC_AWS_S3_BUCKET=
AERODOC_AZURE_CONNECTION_STRING=PLACEHOLDER__SET_IN_SECRET_STORE
AERODOC_AZURE_CONTAINER=
AERODOC_ONPREM_SFTP_HOST=
AERODOC_ONPREM_SFTP_PORT=22
AERODOC_ONPREM_SFTP_USER=
AERODOC_ONPREM_SFTP_PASSWORD=PLACEHOLDER__SET_IN_SECRET_STORE
AERODOC_ONPREM_SFTP_ROOT=/
