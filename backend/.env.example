# OpenAI credentials are backend-only. Never prefix these variables with VITE_.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5-mini
OPENAI_LIGHTWEIGHT_MODEL=gpt-5-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_PREMIUM_MODEL=gpt-5

# Optional provider policy and bounded retry configuration.
AI_ALLOWED_CHAT_MODELS=gpt-5-mini,gpt-5-nano,gpt-5
AI_ALLOWED_EMBEDDING_MODELS=text-embedding-3-small
AI_PROVIDER_TIMEOUT_SECONDS=15
AI_PROVIDER_MAX_RETRIES=2
AI_PROVIDER_RETRY_BASE_MS=250

# Zero means unlimited until a tenant-specific AI plan is saved by an administrator.
AI_DEFAULT_PLAN_TYPE=DEVELOPMENT
AI_DEFAULT_MONTHLY_TOKEN_ALLOWANCE=0
AI_DEFAULT_MONTHLY_REQUEST_ALLOWANCE=0
AI_DEFAULT_MAX_INPUT_TOKENS_PER_REQUEST=0
AI_DEFAULT_MAX_OUTPUT_TOKENS_PER_REQUEST=0

# Optional billing estimates: {"model":{"input":USD_per_million,"output":USD_per_million}}
AI_MODEL_PRICING_USD_PER_MILLION_JSON={}
