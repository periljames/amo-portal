# Venspera paid multi-tenant profile — commissioning values ONLY.
# This is a template, not evidence of high availability or backup recovery.
# Do not activate paying tenants until F08/F11/F12/F13 are accepted.
APP_ENV=production
PORTAL_DOMAIN=https://app.venspera.com
PORTAL_BASE_URL=https://app.venspera.com
FRONTEND_BASE_URL=https://app.venspera.com
CORS_ALLOWED_ORIGINS=https://app.venspera.com
CORS_ALLOW_CREDENTIALS=true
PORTAL_REFRESH_COOKIE_SECURE=true
PORTAL_ALLOW_HTTP_BOOTSTRAP=0
SCHEMA_STRICT=true

# Fill using distinct secrets; do not commit real values.
SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_KEY
REFRESH_TOKEN_PEPPER=CHANGE_ME_RANDOM_REFRESH_PEPPER
RESET_TOKEN_PEPPER=CHANGE_ME_RANDOM_RESET_PEPPER
PLATFORM_SECRETS_KEY=CHANGE_ME_ENCRYPTION_SECRET

# DB addresses MUST be private. Runtime role != migration role.
DATABASE_WRITE_URL=postgresql+psycopg2://venspera_runtime:CHANGE_ME@PRIVATE_DB_HOST:5432/amodb?sslmode=verify-full
DATABASE_READ_URL=postgresql+psycopg2://venspera_read:CHANGE_ME@PRIVATE_DB_REPLICA_HOST:5432/amodb?sslmode=verify-full
DATABASE_MIGRATION_URL=postgresql+psycopg2://venspera_migration:CHANGE_ME@PRIVATE_DB_HOST:5432/amodb?sslmode=verify-full

# Shared object store; one bucket with tenant namespace, encryption, versioning
# and tested lifecycle/retention/backup policies.
AMO_STORAGE_BACKEND=s3
AMO_REQUIRE_SHARED_STORAGE=true
AMO_INSTALL_SHARED_STORAGE_ROUTE_HARDENING=true
AMO_STORAGE_S3_BUCKET=CHANGE_ME_BUCKET
AMO_STORAGE_S3_PREFIX=venspera/prod
AMO_STORAGE_S3_ENDPOINT_URL=CHANGE_ME_S3_COMPATIBLE_ENDPOINT
AMO_STORAGE_CACHE_DIR=/var/cache/venspera/storage

# Critical distributed rate limiting must not fall back per process.
AUTH_RATE_LIMIT_REQUIRE_SHARED=true
AUTH_RATE_LIMIT_REDIS_URL=redis://PRIVATE_REDIS_HOST:6379/0

# Run workers as isolated service processes and deploy at least two API hosts
# behind a health-checked proxy only after object portability is accepted.
PORTAL_EMBEDDED_JOB_WORKER=false
PORTAL_EMBEDDED_SCHEDULED_WORKER=false
DOCUMENT_EVIDENCE_PACK_EMBEDDED_WORKER=false
