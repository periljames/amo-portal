# Google Maps JavaScript API used by the AMO base-location editor.
# Enable Maps JavaScript API and Places API (New), then restrict this browser key
# to the deployed portal origins and only those APIs.
VITE_GOOGLE_MAPS_API_KEY=

# Production vector map ID used by AdvancedMarkerElement. The editor falls back
# to Google's DEMO_MAP_ID during local development when this value is empty.
VITE_GOOGLE_MAPS_MAP_ID=
