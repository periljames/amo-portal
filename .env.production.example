# =========================================================================
# AMO Portal - single-server production template
# =========================================================================
# Copy to .env and fill the values, or let scripts/install.sh generate the
# secrets marked __GENERATE__ / CHANGE_ME_* automatically.
#
# This template targets a self-contained single-server deployment using the
# bundled PostgreSQL (docker-compose.postgres.yml) and local shared storage.
# For horizontally scaled fleets, point DATABASE_WRITE_URL at managed Postgres,
# set AMO_STORAGE_BACKEND=s3 with an object store, and configure Prometheus.
# =========================================================================

APP_ENV=production
TZ=UTC

# Public URL browsers use to reach the portal (scheme + host[:port]).
PORTAL_DOMAIN=http://localhost:3000

# ----- Backend runtime -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080

# Secrets - replaced by scripts/install.sh when left as CHANGE_ME_*.
SECRET_KEY=CHANGE_ME_SECRET_KEY
REFRESH_TOKEN_PEPPER=CHANGE_ME_PEPPER
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Enforce that the running schema matches the migration heads.
SCHEMA_STRICT=true

# CORS: same-origin needs no entries; add external browser origins if the SPA is
# served from a different host than the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
PORTAL_REFRESH_COOKIE_SECURE=false

MAX_REQUEST_BODY_BYTES=52428800
GZIP_MINIMUM_SIZE=1024
GZIP_COMPRESSLEVEL=6

# ----- Bundled database (docker-compose.postgres.yml) -----
AMO_DB_USER=amo
AMO_DB_PASSWORD=CHANGE_ME_DB
AMO_DB_NAME=amodb
DATABASE_WRITE_URL=postgresql+psycopg2://amo:CHANGE_ME_DB@db:5432/amodb
DATABASE_READ_URL=
DATABASE_MIGRATION_URL=postgresql+psycopg2://amo:CHANGE_ME_DB@db:5432/amodb

DB_EXTERNAL_POOLER=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=5
DB_MAX_CONNECTIONS=100
DB_ADMIN_CONNECTION_RESERVE=10
DB_MIGRATION_CONNECTION_RESERVE=5

# ----- Background topology (isolated from the API pool) -----
PORTAL_EMBEDDED_JOB_WORKER=false
PORTAL_EMBEDDED_SCHEDULED_WORKER=false
DOCUMENT_EVIDENCE_PACK_EMBEDDED_WORKER=false
PORTAL_WORKER_PROCESS_COUNT=5
PORTAL_SCHEDULED_PROCESS_COUNT=1
DOCUMENT_EVIDENCE_PACK_PROCESS_COUNT=1
PLATFORM_OPS_GATEWAY_PROCESS_COUNT=1
PLATFORM_OPS_WORKER_PROCESS_COUNT=1
ROSTER_AUTOMATION_PROCESS_COUNT=1

# Platform monitor cadence (host CPU/memory/DB/API snapshot writer).
PLATFORM_INFRA_SNAPSHOT_INTERVAL_SECONDS=30
PLATFORM_HEALTH_PROBE_INTERVAL_SECONDS=120

# ----- Storage (single-server local shared volume) -----
AMO_STORAGE_BACKEND=local
AMO_REQUIRE_SHARED_STORAGE=false
AMO_STORAGE_LOCAL_ROOT=/srv/amo/uploads

# ----- Realtime broker (disabled unless an MQTT broker is provided) -----
REALTIME_ENABLED=false

# ----- Observability (optional; wire Prometheus for host CPU/mem graphs) -----
OTEL_ENABLED=false
# PLATFORM_OPS_PROMETHEUS_URL=http://prometheus:9090

# ----- First platform superuser (created by scripts/install.sh) -----
AMO_SUPERUSER_EMAIL=admin@example.com
AMO_SUPERUSER_PASSWORD=CHANGE_ME_SUPERUSER

# ----- Optional integrations -----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DOCUMENT_AI_PROVIDER=disabled
DOCUMENT_AI_ALLOW_EXTERNAL=false
